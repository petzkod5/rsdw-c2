{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "replicaCount", "memoryPressure", "telemetry", "service", "ingress", "cluster", "auth", "state", "backups", "rbac", "resources", "podSecurityContext", "containerSecurityContext", "nodeSelector", "tolerations", "affinity"],
  "definitions": {
    "duration": {
      "type": "string",
      "minLength": 2,
      "pattern": "^\\+?(?:[0-9]{1,6}h)?(?:[0-9]{1,6}m)?(?:[0-9]{1,6}s)?(?:[0-9]{1,6}ms)?(?:[0-9]{1,6}(?:us|\u00b5s|\u03bcs))?(?:[0-9]{1,6}ns)?$",
      "not": {"pattern": "^\\+?([0.]+(ns|us|\u00b5s|\u03bcs|ms|s|m|h))+$"}
    },
    "optionalDuration": {"anyOf": [{"enum": [""]}, {"$ref": "#/definitions/duration"}]},
    "toggle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {"enabled": {"type": "boolean"}}
    }
  },
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "replicaCount": {"type": "integer", "minimum": 1, "maximum": 1},
    "memoryPressure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "thresholdPercent", "duration"],
      "properties": {
        "enabled": {"type": "boolean"},
        "thresholdPercent": {"type": "number", "minimum": 0, "maximum": 100},
        "duration": {
          "type": "string",
          "minLength": 2,
          "pattern": "^\\+?(?:[0-9]{1,6}h)?(?:[0-9]{1,6}m)?(?:[0-9]{1,6}s)?(?:[0-9]{1,6}ms)?(?:[0-9]{1,6}(?:us|µs|μs))?(?:[0-9]{1,6}ns)?$",
          "not": {"pattern": "^\\+?([0.]+(ns|us|µs|μs|ms|s|m|h))+$"}
        }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tickMetrics", "livenessInterval", "metricsInterval", "timeouts", "execMetrics", "resources", "players", "tick", "network", "disk"],
      "properties": {
        "tickMetrics": {"type": "boolean"},
        "livenessInterval": {"$ref": "#/definitions/duration"},
        "metricsInterval": {"$ref": "#/definitions/duration"},
        "timeouts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kube", "health", "exec"],
          "properties": {
            "kube": {"$ref": "#/definitions/duration"},
            "health": {"$ref": "#/definitions/duration"},
            "exec": {"$ref": "#/definitions/duration"}
          }
        },
        "execMetrics": {"$ref": "#/definitions/toggle"},
        "resources": {"$ref": "#/definitions/toggle"},
        "players": {"$ref": "#/definitions/toggle"},
        "tick": {
          "type": "object",
          "additionalProperties": false,
          "required": ["interval"],
          "properties": {"interval": {"$ref": "#/definitions/optionalDuration"}}
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "interval"],
          "properties": {"enabled": {"type": "boolean"}, "interval": {"$ref": "#/definitions/optionalDuration"}}
        },
        "disk": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "interval"],
          "properties": {"enabled": {"type": "boolean"}, "interval": {"$ref": "#/definitions/duration"}}
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "port"],
      "properties": {
        "type": {"enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "ingressClassName", "annotations", "hosts", "paths", "tls"],
      "properties": {
        "enabled": {"type": "boolean"},
        "ingressClassName": {"type": "string"},
        "annotations": {"type": "object", "additionalProperties": {"type": "string"}},
        "hosts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "pathType"],
            "properties": {
              "path": {"type": "string", "pattern": "^/"},
              "pathType": {"enum": ["Exact", "Prefix", "ImplementationSpecific"]}
            }
          }
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["secretName", "hosts"],
            "properties": {
              "secretName": {"type": "string", "minLength": 1},
              "hosts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
            }
          }
        }
      }
    },
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "region"],
      "properties": {"name": {"type": "string", "minLength": 1}, "region": {"type": "string", "minLength": 1}}
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "adminTokenSecret", "oidc"],
      "properties": {
        "mode": {"enum": ["token", "oidc"]},
        "adminTokenSecret": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "key"],
          "properties": {"name": {"type": "string"}, "key": {"type": "string", "minLength": 1}}
        },
        "oidc": {
          "type": "object",
          "additionalProperties": false,
          "required": ["issuer", "publicOrigin", "clientID", "clientSecret", "scopes", "groupsClaim", "rolePolicy"],
          "properties": {
            "issuer": {"type": "string", "pattern": "^$|^https://[^/?#@\\s]+(/[^?#\\s]*)?$"},
            "publicOrigin": {"type": "string", "pattern": "^$|^https://[^/?#@\\s]+$"},
            "clientID": {"type": "string"},
            "clientSecret": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "key"],
              "properties": {"name": {"type": "string"}, "key": {"type": "string", "minLength": 1}}
            },
            "scopes": {
              "type": "array", "minItems": 1, "uniqueItems": true, "contains": {"const": "openid"},
              "items": {"type": "string", "pattern": "^[^\\s]+$", "not": {"const": "offline_access"}}
            },
            "groupsClaim": {"type": "string", "minLength": 1, "pattern": "\\S"},
            "rolePolicy": {
              "type": "object",
              "additionalProperties": false,
              "required": ["adminSubjects", "viewerSubjects", "adminGroups", "viewerGroups"],
              "properties": {
                "adminSubjects": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "\\S"}},
                "viewerSubjects": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "\\S"}},
                "adminGroups": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "\\S"}},
                "viewerGroups": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "\\S"}}
              }
            }
          }
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["persistence"],
      "properties": {
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "size"],
          "properties": {"enabled": {"type": "boolean"}, "size": {"type": "string", "minLength": 1}, "storageClass": {"type": ["string", "null"]}}
        }
      }
    },
    "backups": {
      "type": "object",
      "additionalProperties": false,
      "required": ["persistence", "path", "maxRepositoryBytes", "maxItemBytes", "maxBundleBytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "maxRepositoryBytes": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "maxItemBytes": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "maxBundleBytes": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "size"],
          "properties": {"enabled": {"type": "boolean"}, "size": {"type": "string", "minLength": 1}, "storageClass": {"type": ["string", "null"]}}
        }
      }
    },
    "rbac": {"type": "object", "additionalProperties": false, "required": ["create"], "properties": {"create": {"type": "boolean"}}},
    "resources": {"type": "object"},
    "podSecurityContext": {"type": "object"},
    "containerSecurityContext": {"type": "object"},
    "nodeSelector": {"type": "object"},
    "tolerations": {"type": "array"},
    "affinity": {"type": "object"}
  }
}
